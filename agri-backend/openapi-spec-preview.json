          }
        }
      }
    },
    "/api/products/predictions": {
      "get": {
        "summary": "Get price trend predictions for a product",
        "description": "Requires the caller's `price_predictions_enabled` notification setting to be true (see PUT /api/notifications). The model is currently a placeholder (`model: \"dummy\"`), not real forecasting.\n",
        "tags": [
          "Products"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "productId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "days",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 7
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Predicted prices.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing `productId`, or `days` is not a positive integer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "description": "Price predictions are disabled for this account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
